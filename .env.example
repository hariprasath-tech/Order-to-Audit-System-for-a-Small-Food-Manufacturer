# Environment configuration for Order-to-Audit System
# Instructions: Copy this file to .env before starting containers:
#   cp .env.example .env

DEBUG=False
SECRET_KEY=snackfactory-super-secret-random-production-key-change-me-12345
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# Demo Mode (Displays quick role test login buttons on the sign-in screen)
DEMO_MODE=True

# HTTPS and CSRF settings (Set USE_HTTPS=True only when behind SSL / TLS termination)
USE_HTTPS=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgres://snackuser:snackpass@db:5432/snackfactory
POSTGRES_DB=snackfactory
POSTGRES_USER=snackuser
POSTGRES_PASSWORD=snackpass

# GST & Company Configuration (Tamil Nadu state code 33)
SELLER_NAME=Kaveri Foods Mfg Ltd
SELLER_GSTIN=33AAAAA0000A1Z5
SELLER_STATE_CODE=33

# Production Variance Engine Defaults (Strict Decimal string)
DEFAULT_VARIANCE_TOLERANCE=3.00

# Container Startup Seeding (Set true to automatically run seed_benchmark on start)
SEED_ON_START=false
