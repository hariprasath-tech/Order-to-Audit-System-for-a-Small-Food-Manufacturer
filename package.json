{
  "name": "order-to-audit-frontend",
  "version": "1.0.0",
  "description": "Front-end asset pipeline and motion design system for Order-to-Audit System",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/app.css -o ./static/dist/app.min.css --minify",
    "dev:css": "tailwindcss -i ./static/css/app.css -o ./static/dist/app.min.css --watch",
    "setup:vendor": "node ./scripts/copy-vendor.js",
    "build": "npm run setup:vendor && npm run build:css",
    "dev": "npm run dev:css"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "alpinejs": "^3.14.8",
    "gsap": "^3.12.5",
    "htmx.org": "^2.0.4"
  }
}
